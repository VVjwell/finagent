# 复制为 .env 并填入自己的 key（这个文件可以提交，.env 千万别）

# ============================================================ #
#  必填
# ============================================================ #

# ---------- LLM ----------
# 任何 OpenAI 兼容的服务都行：OpenAI / DeepSeek / Moonshot / 智谱 / 本地 vLLM / Ollama 等
LLM_API_KEY=sk-xxx
LLM_MODEL=gpt-4o-mini
# 可选。OpenAI 官方留空即可。其他例子：
#   DeepSeek:  https://api.deepseek.com/v1
#   Moonshot:  https://api.moonshot.cn/v1
#   智谱:      https://open.bigmodel.cn/api/paas/v4
#   本地 vLLM: http://localhost:8000/v1
#   Ollama:    http://localhost:11434/v1
LLM_BASE_URL=
LLM_TEMPERATURE=0.1
# MCP 工具返回 content 的格式。
#   "string" — 国产 / Groq / Together 等 OpenAI 兼容端用这个
#   "blocks" — OpenAI 官方 / Anthropic / Azure 用这个（支持多模态 ToolMessage）
LLM_TOOL_CONTENT_FORMAT=string

# ============================================================ #
#  数据源（可选，缺哪个对应工具就不可用）
# ============================================================ #

# Finnhub —— 股票行情 / 财务 / 公司新闻
FINNHUB_API_KEY=

# Tavily —— deep_search 网搜后端
TAVILY_API_KEY=

# FRED —— 美联储经济数据（CPI / 失业率 / 利率曲线等 80 万+ 时间序列）
# 申请：https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# ============================================================ #
#  Embedding（语义记忆检索；不配则记忆 MCP 退化到关键字搜索）
# ============================================================ #

# 后端选择："zhipu" / "local"
EMBEDDING_PROVIDER=zhipu

# zhipu 后端配置（provider=zhipu 时用）
# 申请 key：https://open.bigmodel.cn/usercenter/apikeys
ZHIPU_API_KEY=

# local 后端配置（provider=local 时用，需先装 requirements-embedding.txt）
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
LOCAL_EMBEDDING_DIM=512
# cpu / cuda / mps，留空让 sentence-transformers 自动选
LOCAL_EMBEDDING_DEVICE=
LOCAL_EMBEDDING_LOCAL_FILES_ONLY=true

EMBEDDING_TIMEOUT_SECONDS=8

# ============================================================ #
#  Agent 行为
# ============================================================ #

# 给 agent 指定一份固定的 system prompt（推荐用项目自带的 invest_agent.txt）
# AGENT_SYSTEM_PROMPT_FILE=prompts/invest_agent.txt

# 短期对话历史保留条数；长期事实请走 memory / portfolio。0 表示不裁剪
AGENT_MAX_HISTORY_MESSAGES=16

# Filesystem MCP 的根目录（agent 可见的全部范围）。留空 = 项目根
# AGENT_WORKSPACE_DIR=.

# 时区，传给 mcp-server-time。空 = 系统自动检测
# AGENT_LOCAL_TIMEZONE=Asia/Shanghai
